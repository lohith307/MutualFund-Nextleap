# ─────────────────────────────────────────────────────────────
#  Mutual Fund FAQ Assistant — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider (choose one) ────────────────────────────────
# Groq (recommended: ultra-low latency & free tier)
GROQ_API_KEY=gsk_...

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini (alternative)
GOOGLE_API_KEY=AIza...

# ── LLM Settings ─────────────────────────────────────────────
LLM_PROVIDER=groq                    # "groq" | "openai" | "gemini"
LLM_MODEL=llama-3.3-70b-versatile    # e.g. llama-3.3-70b-versatile | llama-3.1-8b-instant | gpt-4o-mini | gemini-1.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=200

# ── Embedding Settings ────────────────────────────────────────
EMBEDDING_PROVIDER=bge               # "bge" (free/local) | "openai"
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 # e.g. BAAI/bge-small-en-v1.5 | BAAI/bge-large-en-v1.5 | text-embedding-3-small
EMBEDDING_DEVICE=cpu                 # "cpu" | "cuda"

# ── Vector Store ─────────────────────────────────────────────
VECTOR_STORE_PATH=corpus/vector_store
VECTOR_STORE_COLLECTION=mutual_fund_faq

# ── Retriever Settings ────────────────────────────────────────
RETRIEVER_TOP_K=5
RETRIEVER_SIMILARITY_THRESHOLD=0.70

# ── Ingestion Settings ────────────────────────────────────────
CHUNK_SIZE=450
CHUNK_OVERLAP=50
REQUEST_TIMEOUT=15                   # seconds per URL fetch
REQUEST_DELAY=1.5                    # seconds between requests (rate limiting)

# ── API Settings ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── App Settings ─────────────────────────────────────────────
LOG_LEVEL=INFO

